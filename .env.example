DATABASE_URL=postgresql://bostadspriser:bostadspriser@localhost:5432/bostadspriser

MAPBOX_TOKEN=pk.your_mapbox_public_token_here
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

SCRAPER_CACHE_DIR=./scraper/.cache
SCRAPER_STORAGE_STATE=./scraper/.state/storageState.json
SCRAPER_MIN_DELAY_MS=3000
SCRAPER_MAX_DELAY_MS=5000

# Cache invalidation (web/src/app/api/revalidate): the web server and the
# scraper share the secret (at least 16 characters; shorter counts as unset).
# The scraper should POST to $APP_URL/api/revalidate after refreshing the
# DedupedListingMat snapshot. APP_URL is where the web app is reachable from it.
REVALIDATE_SECRET=
APP_URL=http://localhost:3000
