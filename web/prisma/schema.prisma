generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum District {
  ostermalm
  vasastan
  norrmalm
  sodermalm
}

model Listing {
  id              String        @id @default(uuid())
  source          String
  sourceId        String
  // Deterministic hash of (normalized street, houseNumber, soldAt, priceSek) —
  // collapses the same real-world sale observed via Hemnet and Booli.
  // Multiple rows can share a dedupKey; aggregations select DISTINCT ON it.
  // Nullable while we backfill the legacy Hemnet rows; new writes always set it.
  dedupKey        String?       @db.VarChar(64)
  // Fuzzy-match cluster (same street + house, sold within a few days, price
  // within a fraction of a percent): every copy of one real-world sale gets the
  // same id, even when their exact dedupKeys differ. DedupedListing derives a
  // canonical key from both columns: a row's own clusterId, else the cluster of
  // any row sharing its dedupKey, else its dedupKey, else its id. Contract for
  // the matcher: all rows sharing a dedupKey carry one clusterId (new exact
  // copies arrive without one until the matcher runs again), and merging two
  // clusters rewrites the smaller one's rows to the larger's id.
  // aggregations.ts dedupKeysInMultipleClusters() lists violations. Null = not
  // clustered.
  clusterId       String?       @db.VarChar(64)
  street          String
  houseNumber     String?
  district        District
  rooms           Decimal?      @db.Decimal(4, 1)
  areaSqm         Decimal?      @db.Decimal(6, 1)
  priceSek        BigInt
  pricePerSqmSek  BigInt
  soldAt          DateTime      @db.Date
  lat             Float?
  lng             Float?
  raw             Json
  scrapedAt       DateTime      @default(now())
  // When a scraper last saw this sale (set on insert, refreshed by every
  // upsert). `scrapedAt` is only the first insert. DedupedListing's final
  // tie-breaker.
  lastSeenAt      DateTime      @default(now())
  geocodedAt      DateTime?
  // Outcome of the last geocoding attempt (`geocodedAt` alone can't tell a
  // successful lookup from one that found nothing). `inline` = the source
  // shipped the coordinates itself; `pending` = never tried or retry wanted.
  geocodeStatus   GeocodeStatus @default(pending)
  geocodeAttempts Int           @default(0)

  @@unique([source, sourceId])
  @@index([dedupKey])
  // Serves the fuzzy matcher's lookups; DedupedListing does not use it.
  @@index([clusterId])
  @@index([district, soldAt])
  @@index([street, houseNumber, soldAt])
  @@index([lat, lng])
  @@index([geocodeStatus])
}

enum GeocodeStatus {
  pending
  ok
  not_found
  failed
  inline
}

enum ScrapeStatus {
  running
  ok
  partial
  failed
}

// One row per scraper invocation for a (source, district). The scraper inserts
// it as `running`, bumps the counters while paging, and closes it with a final
// status. `oldestSoldAt` is the oldest sale date that run reached: coverage
// for gap healing (B19).
model ScrapeRun {
  // Generated by the database so the scraper's reflected insert needs no id.
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  source       String
  district     District
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  pages        Int          @default(0)
  rowsUpserted Int          @default(0)
  rowsRejected Int          @default(0)
  status       ScrapeStatus @default(running)
  error        String?
  oldestSoldAt DateTime?    @db.Date

  @@index([source, district, startedAt])
}
