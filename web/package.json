{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:build": "NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_MAPBOX_TOKEN= next build",
    "db:test": "node scripts/test-db.cjs",
    "screens": "playwright test -c playwright.screens.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "h3-js": "^4.4.0",
    "mapbox-gl": "^3.23.0",
    "next": "15.5.15",
    "prisma": "^6.16.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/env": "15.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
